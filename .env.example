# Copy to `.env` (cp .env.example .env). Everything has a sensible default, so this is OPTIONAL for local use.
# Never commit your real .env.

# ---- PostgreSQL container ----
POSTGRES_USER=teamdesk
POSTGRES_PASSWORD=teamdesk
POSTGRES_DB=teamdesk
DB_PORT=5432

# ---- Backend ----
# local | test | staging | production  (staging/production REQUIRE a real SECRET_KEY)
ENVIRONMENT=local
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=60
# load demo users + tickets on first start (demo only!)
SEED_DEMO_DATA=true

# Used when you run the API on your laptop (not in Docker). In Docker, compose sets this for you.
DATABASE_URL=postgresql+psycopg://teamdesk:teamdesk@localhost:5432/teamdesk

# ---- Streamlit UI ----
# In Docker, compose overrides this to http://backend:8000
API_URL=http://localhost:8000

# ---- Observability (optional) ----
# Get a write token at https://logfire.pydantic.dev  (free tier) -> project -> Settings -> Write tokens.
# Without it, logs just print to the console.
# LOGFIRE_TOKEN=
